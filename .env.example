# Copy this file to ".env" and fill in your values.
# Never commit the real ".env" file.

# Select Gemini (cloud) or Ollama (local model server).
AI_PROVIDER=gemini

# API key for the selected provider
AI_API_KEY=

# Model name for the selected provider
AI_MODEL=gemini-3.5-flash-lite

# Ollama profile (edit these values and set AI_PROVIDER=ollama to use it).
# Ollama runs locally and does not require AI_API_KEY.
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_TIMEOUT=120
# OLLAMA_KEEP_ALIVE=24h
# OLLAMA_WARMUP=true

# Optional settings (sensible defaults applied if omitted)
# Interactive voice/text defaults bound retries for a non-responsive API.
# Configured no-response budget: attempts * (connect + read) + exponential backoff.
# requests treats read timeout as socket inactivity, so it is not a strict deadline
# if response data continues arriving slowly.
# AI_TIMEOUT=30
# AI_CONNECT_TIMEOUT=5
# AI_READ_TIMEOUT=12
# AI_MAX_RETRIES=1
# AI_RETRY_BACKOFF=0.5
# AI_CIRCUIT_FAILURE_THRESHOLD=3
# AI_CIRCUIT_COOLDOWN=30
# MAX_TOOL_ROUNDS=5
# MAX_HISTORY_MESSAGES=30
# Optional local persistent memory database location (default: data/aeris_memory.sqlite3)
# AERIS_MEMORY_DB_PATH=
# Maximum saved memory records (default: 500; full stores refuse new memories without deleting any)
# AERIS_MEMORY_MAX_RECORDS=500
# VOICE_MAX_HISTORY_MESSAGES=16
# STT_TIMEOUT=4
# STT_PHRASE_TIME_LIMIT=12
# STT_PAUSE_THRESHOLD=0.55
# STT_NON_SPEAKING_DURATION=0.3
# STT_ENERGY_THRESHOLD=300
# STT_DYNAMIC_ENERGY=true
# TTS_RATE=175
# TTS_VOLUME=1.0
# TTS_VOICE=
# VOICE_DEBUG=false
# WAKE_WORD_ENABLED=false
# WAKE_WORD=aeris
# VOICE_ACTIVE_WINDOW=10
# MIC_DEVICE_INDEX=
# MIC_DEVICE_NAME=
# MIC_AUTO_SELECT=true
# VOICE_STREAMING_ENABLED=false
# VOICE_STREAMING=false
# VOICE_STREAM_MIN_CHARS=40
# VOICE_STREAM_MAX_CHARS=180
# VOICE_STREAM_FLUSH_TIMEOUT=0.8
# Logging & rotation settings
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=2097152
# LOG_BACKUP_COUNT=5
# LOG_FILE=aeris.log
